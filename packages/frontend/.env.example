# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_me_in_production
MONGO_URI=mongodb://localhost:27017/adaptiq
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=adaptiq-backend

# AI-Engine Configuration
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=adaptiq-index

# S3 storage (mocked or active)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_S3_BUCKET=adaptiq-assets
